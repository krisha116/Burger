{% extends 'layout/adventure_landing.html.twig' %}

{% block title %}Sign in — Grilled & Bites Burger{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  /* Login page: full-bleed over adv-body */
  .gb-login-page {
    --gb-login-gold: #f5c518;
    --gb-login-gold-deep: #c9a227;
    --gb-login-red: #c41e3a;
    --gb-login-ink: #0c0a09;
    --gb-login-glass: rgba(255, 255, 255, 0.09);
    --gb-login-glass-border: rgba(255, 255, 255, 0.14);
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr;
    position: relative;
    overflow: hidden;
    font-family: 'Montserrat', system-ui, sans-serif;
    color: rgba(255, 255, 255, 0.92);
  }

  @media (min-width: 960px) {
    .gb-login-page {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  .gb-login-page__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 120% 80% at 20% 20%, rgba(245, 197, 24, 0.18), transparent 55%),
      radial-gradient(ellipse 90% 70% at 85% 75%, rgba(196, 30, 58, 0.22), transparent 50%),
      linear-gradient(165deg, #12100e 0%, #1a1410 45%, #0d0c0b 100%);
  }

  .gb-login-page__burger {
    position: absolute;
    right: -8%;
    bottom: -12%;
    width: min(72vw, 640px);
    opacity: 0.22;
    filter: blur(2px);
    transform: rotate(-8deg);
    pointer-events: none;
    user-select: none;
  }

  @media (min-width: 960px) {
    .gb-login-page__burger {
      display: none;
    }
  }

  .gb-login-hero {
    position: relative;
    z-index: 1;
    display: none;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem);
    overflow: hidden;
  }

  @media (min-width: 960px) {
    .gb-login-hero {
      display: flex;
    }
  }

  .gb-login-hero__glow {
    position: absolute;
    width: 140%;
    height: 140%;
    left: -20%;
    top: -20%;
    background: radial-gradient(circle at 40% 50%, rgba(245, 197, 24, 0.15), transparent 55%);
    pointer-events: none;
  }

  .gb-login-hero__frame {
    position: relative;
    max-width: 420px;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem);
    border-radius: 50%;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.03));
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1) inset,
      0 32px 64px rgba(0, 0, 0, 0.35);
  }

  .gb-login-hero__frame::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(245, 197, 24, 0.5), rgba(196, 30, 58, 0.25), transparent 65%);
    z-index: -1;
    opacity: 0.85;
  }

  .gb-login-hero__img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.45));
  }

  .gb-login-hero__tagline {
    margin-top: 2rem;
    text-align: center;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.5;
  }

  .gb-login-hero__tagline span {
    display: block;
    color: var(--gb-login-gold);
    font-size: 0.72em;
    letter-spacing: 0.2em;
    margin-top: 0.35rem;
  }

  .gb-login-aside {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4.25rem, 14vw, 5.5rem) clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem);
  }

  @media (min-width: 960px) {
    .gb-login-aside {
      padding: clamp(1.5rem, 4vw, 3rem);
    }
  }

  .gb-login-brand {
    position: absolute;
    top: clamp(1rem, 3vw, 1.75rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    font-family: 'Yellowtail', cursive;
    font-size: clamp(1.35rem, 3.5vw, 1.75rem);
    color: var(--gb-login-gold);
    text-decoration: none;
    text-shadow: 0 0 32px rgba(245, 197, 24, 0.35);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .gb-login-brand:hover {
    color: #ffd54a;
    transform: translateX(-50%) scale(1.02);
  }

  @media (min-width: 960px) {
    .gb-login-brand {
      left: clamp(1.5rem, 4vw, 2.5rem);
      transform: none;
    }
    .gb-login-brand:hover {
      transform: scale(1.02);
    }
  }

  .gb-login-card {
    width: 100%;
    max-width: 420px;
    padding: clamp(1.75rem, 4vw, 2.35rem);
    border-radius: 24px;
    background: var(--gb-login-glass);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    border: 1px solid var(--gb-login-glass-border);
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(0, 0, 0, 0.2) inset;
  }

  .gb-login-card__eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gb-login-gold);
    margin: 0 0 0.5rem;
  }

  .gb-login-card h1 {
    margin: 0 0 0.35rem;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: clamp(1.65rem, 4vw, 2rem);
    letter-spacing: 0.04em;
    color: #fff;
    line-height: 1.2;
  }

  .gb-login-card__subtitle {
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.58);
    line-height: 1.5;
  }

  .gb-login-card label {
    display: block;
    margin: 1.1rem 0 0.4rem;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .gb-login-card label:first-of-type {
    margin-top: 0;
  }

  .gb-login-card input[type="text"],
  .gb-login-card input[type="password"] {
    width: 100%;
    height: 48px;
    padding: 0 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    font-size: 0.95rem;
    font-family: inherit;
    color: #fff;
    background: rgba(0, 0, 0, 0.28);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .gb-login-card input::placeholder {
    color: rgba(255, 255, 255, 0.28);
  }

  .gb-login-card input:focus {
    outline: none;
    border-color: rgba(245, 197, 24, 0.55);
    background: rgba(0, 0, 0, 0.38);
    box-shadow: 0 0 0 3px rgba(245, 197, 24, 0.12);
  }

  .gb-login-alert {
    border-radius: 12px;
    padding: 0.85rem 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 1rem;
    border: 1px solid rgba(248, 113, 113, 0.45);
    background: rgba(127, 29, 29, 0.35);
    color: #fecaca;
  }

  .gb-login-session {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(0, 0, 0, 0.25);
    padding: 0.85rem 1rem;
    border-radius: 12px;
    margin-bottom: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .gb-login-session a {
    color: var(--gb-login-gold);
    font-weight: 600;
  }

  .gb-login-submit {
    width: 100%;
    margin-top: 1.5rem;
    height: 50px;
    border: none;
    border-radius: 14px;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    color: #1a1208;
    background: linear-gradient(135deg, #ffd54a, var(--gb-login-gold) 40%, var(--gb-login-gold-deep));
    box-shadow:
      0 4px 16px rgba(245, 197, 24, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.15) inset;
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  }

  .gb-login-submit:hover {
    filter: brightness(1.05);
    box-shadow:
      0 8px 28px rgba(245, 197, 24, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.2) inset;
    transform: translateY(-2px);
  }

  .gb-login-submit:active {
    transform: translateY(0);
  }

  .gb-login-submit:focus-visible {
    outline: 2px solid var(--gb-login-gold);
    outline-offset: 3px;
  }

  .gb-login-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }

  .gb-login-divider::before,
  .gb-login-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
  }

  .gb-login-register {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.85rem 1rem;
    text-align: center;
    text-decoration: none;
    border-radius: 14px;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.04);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .gb-login-register:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(245, 197, 24, 0.45);
    transform: translateY(-1px);
  }

  .gb-login-register:focus-visible {
    outline: 2px solid var(--gb-login-gold);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .gb-login-submit:hover,
    .gb-login-register:hover,
    .gb-login-brand:hover {
      transform: none;
    }
  }
</style>
{% endblock %}

{% block body %}
<div class="gb-login-page">
  <div class="gb-login-page__bg" aria-hidden="true"></div>
  <img
    class="gb-login-page__burger gb-brand-mark"
    src="{{ asset('uploads/images/grilled-bites-mark.svg') }}"
    alt=""
    width="256"
    height="288"
    loading="lazy"
    decoding="async"
  >

  <a href="{{ path('app_home') }}" class="gb-login-brand">Grilled &amp; Bites Burger</a>

  <div class="gb-login-hero" aria-hidden="true">
    <div class="gb-login-hero__glow"></div>
    <div>
      <div class="gb-login-hero__frame">
        <img
          class="gb-login-hero__img"
          src="{{ asset('uploads/images/contact-burger-classic.png') }}"
          alt=""
          width="380"
          height="380"
          loading="lazy"
        >
      </div>
      <p class="gb-login-hero__tagline">
        Flame-grilled flavor
        <span>Since day one</span>
      </p>
    </div>
  </div>

  <div class="gb-login-aside">
    <div class="gb-login-card">
      {% if error %}
        <div class="gb-login-alert" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
      {% endif %}

      {% for message in app.flashes('oauth_error') %}
        <div class="gb-login-alert" role="alert">{{ message }}</div>
      {% endfor %}

      {% if app.user %}
        <div class="gb-login-session">
          Signed in as <strong>{{ app.user.userIdentifier }}</strong> —
          <a href="{{ path('app_logout') }}">Log out</a>
        </div>
      {% endif %}

      <p class="gb-login-card__eyebrow">Member access</p>
      <h1>Welcome back</h1>
      <p class="gb-login-card__subtitle">Sign in to order, track bites, and pick up where you left off.</p>

      <form method="post" autocomplete="on">
        <label for="inputUsername">Username</label>
        <input
          type="text"
          value="{{ last_username }}"
          name="username"
          id="inputUsername"
          autocomplete="username"
          required
          autofocus
          placeholder="your.username"
        >

        <label for="inputPassword">Password</label>
        <input
          type="password"
          name="password"
          id="inputPassword"
          autocomplete="current-password"
          required
          placeholder="••••••••"
        >

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="gb-login-submit">Sign in</button>
      </form>

      {% block staff_google_oauth %}{% endblock %}

      <div class="gb-login-divider">New here?</div>
      <a href="{{ path('app_register') }}" class="gb-login-register">Create an account</a>
    </div>
  </div>
</div>

<script>
  (function () {
    if (window.history && window.history.pushState) {
      window.history.replaceState(null, '', window.location.href);
      window.history.pushState(null, '', window.location.href);
      window.addEventListener('popstate', function () {
        window.history.pushState(null, '', window.location.href);
        window.location.replace(window.location.href);
      });
      window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
          window.location.replace(window.location.href);
        }
      });
    }
  })();
</script>
{% endblock %}

                <p>Quick and efficient service without compromising on quality or taste.</p>
            </div>
        </div>
    </div>
</section>

<!-- Menu Highlights -->
<section class="menu-highlights" id="menu">
    <div class="container">
        <h2 class="section-title">Our Signature Burgers</h2>
        <div class="menu-grid">
            <div class="menu-item">
                <div class="menu-item-image">🍔</div>
                <div class="menu-item-content">
                    <h3>Classic Cheeseburger</h3>
                    <p>Juicy beef patty with melted cheese, lettuce, tomato, and our special sauce.</p>
                    <div class="price">$12.99</div>
                </div>
            </div>
            <div class="menu-item">
                <div class="menu-item-image">🥓</div>
                <div class="menu-item-content">
                    <h3>Bacon Deluxe</h3>
                    <p>Double beef patty with crispy bacon, cheddar cheese, and grilled onions.</p>
                    <div class="price">$15.99</div>
                </div>
            </div>
            <div class="menu-item">
                <div class="menu-item-image">🌶️</div>
                <div class="menu-item-content">
                    <h3>Spicy Jalapeño</h3>
                    <p>Spicy beef patty with jalapeños, pepper jack cheese, and chipotle mayo.</p>
                    <div class="price">$14.99</div>
                </div>
            </div>
            <div class="menu-item">
                <div class="menu-item-image">🧀</div>
                <div class="menu-item-content">
                    <h3>Mushroom Swiss</h3>
                    <p>Beef patty topped with sautéed mushrooms and Swiss cheese.</p>
                    <div class="price">$13.99</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="footer" id="contact">
    <div class="footer-content">
        <h3>Grilled & Bites Burger</h3>
        <p>📍 123 Burger Street, Food City, FC 12345</p>
        <p>📞 (555) 123-BURGER</p>
        <p>✉️ info@grilledandbites.com</p>
        <p>🕒 Open Daily: 11:00 AM - 10:00 PM</p>
</div>
</footer>

{% endblock %}

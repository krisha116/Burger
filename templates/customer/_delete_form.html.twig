<form method="post" action="{{ path('app_customer_delete', {id: customer.id}) }}" class="cd-inline-form" onsubmit="return confirm('Are you sure you want to delete this customer?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customer.id) }}">
    <button type="submit" class="ue-btn ue-btn--danger">Delete</button>
</form>

{% extends 'layout/adventure_landing.html.twig' %}

{% block title %}My orders — Grilled &amp; Bites Burger{% endblock %}

{% block stylesheets %}
<style>
{% include 'customer/_shop_shared_styles.html.twig' %}

  .mo-page {
    background: #0c0e12;
    min-height: 100vh;
    padding-bottom: 2rem;
  }
  .mo-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 2rem;
  }
  .mo-head {
    margin-bottom: 1.5rem;
  }
  .mo-head h1 {
    font-family: 'Outfit', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.5rem, 4vw, 1.85rem);
    color: #fff;
    letter-spacing: -0.03em;
    margin: 0 0 0.35rem;
  }
  .mo-head p {
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.9rem;
  }
  .mo-card {
    background: #faf9f7;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .mo-card::before {
    content: '';
    display: block;
    height: 4px;
    background: linear-gradient(90deg, #e8b339, #f59e0b, #c41e3a);
  }
  .mo-empty {
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: #64748b;
    font-size: 0.95rem;
  }
  .mo-empty a {
    color: #b45309;
    font-weight: 700;
  }
  .mo-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mo-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }
  @media (max-width: 540px) {
    .mo-row {
      grid-template-columns: 1fr;
    }
    .mo-row__total,
    .mo-row__status,
    .mo-row a.mo-btn { text-align: left !important; }
    .mo-row > div:last-child { text-align: left; }
  }
  .mo-row:last-child { border-bottom: none; }
  .mo-row__id {
    font-family: 'Outfit', system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.05rem;
    color: #0f172a;
  }
  .mo-row__meta {
    font-size: 0.8rem;
    color: #64748b;
    margin-top: 0.25rem;
  }
  .mo-row__total {
    font-weight: 800;
    font-size: 1.1rem;
    color: #0f172a;
    text-align: right;
  }
  .mo-row__status {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0d9488;
    margin-top: 0.35rem;
    text-align: right;
  }
  .mo-row__status.is-pending { color: #b45309; }
  .mo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.9rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    background: linear-gradient(135deg, #e8b339, #d4a017);
    color: #1a1204;
    white-space: nowrap;
  }
  .mo-btn:hover { filter: brightness(1.06); color: #1a1204; }
  .mo-bar {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .mo-bar a {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(232, 179, 57, 0.95);
    text-decoration: none;
  }
  .mo-bar a:hover { text-decoration: underline; }
</style>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="adv-page mo-page" x-data="{ mobileOpen: false }">
  <header class="gb-menu-page-header">
    {% include 'customer/_shop_nav_bars.html.twig' with {
      on_menu_page: false,
      on_about_page: false,
      on_my_orders_page: true,
      cartProducts: cartProducts
    } %}
  </header>

  <div class="mo-inner">
    <div class="mo-head">
      <h1>My orders</h1>
      <p>Receipts for orders you placed while signed in.</p>
    </div>

    <div class="mo-card">
      {% if orders|length > 0 %}
        <ul class="mo-list">
          {% for order in orders %}
            <li class="mo-row">
              <div>
                <div class="mo-row__id">Order #{{ order.id }}</div>
                <div class="mo-row__meta">
                  {{ order.createAt ? order.createAt|date('M j, Y · g:i A') : '—' }}
                  ·
                  {% if order.paymentMethod == 'cash' %}Cash
                  {% elseif order.paymentMethod == 'gcash' %}GCash
                  {% elseif order.paymentMethod == 'atm' %}ATM
                  {% else %}—{% endif %}
                  · {{ order.products|length }} item{% if order.products|length != 1 %}s{% endif %}
                </div>
              </div>
              <div>
                <div class="mo-row__total">₱{{ order.total }}</div>
                <div class="mo-row__status {% if order.status|lower == 'pending' %}is-pending{% endif %}">{{ order.status }}</div>
                <div style="margin-top:0.5rem;text-align:right;">
                  <a href="{{ path('customer_receipt', { id: order.id }) }}" class="mo-btn">View receipt</a>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="mo-empty">
          <p>You don’t have any orders yet.</p>
          <p style="margin-top:0.75rem;"><a href="{{ path('customer_menu') }}">Browse the menu</a> to place your first order.</p>
        </div>
      {% endif %}
    </div>

    <div class="mo-bar">
      {% if cartProducts|length > 0 %}
        <a href="{{ path('customer_checkout') }}">Cart checkout ({{ cartProducts|length }})</a>
      {% endif %}
      <a href="{{ path('customer_menu') }}">Back to menu</a>
      <a href="{{ path('app_home') }}">Home</a>
    </div>
  </div>

  {% if cartProducts|length > 0 %}
    <a href="{{ path('customer_checkout') }}" class="adv-cart-fab" aria-label="Checkout">
      🛒
      <span>{{ cartProducts|length }}</span>
    </a>
  {% endif %}
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Edit {{ customer.Name }} — Customer{% endblock %}

{% block body %}
<main class="ue-page">
    <div class="ue-shell">
        <a href="{{ path('app_customer_index') }}" class="ue-back">← Back to customers</a>

        <div class="ue-card">
            <header class="ue-card__head">
                <p class="ue-card__eyebrow">Customer #{{ customer.id }}</p>
                <h1 class="ue-card__title">Edit customer</h1>
            </header>
            <div class="ue-card__body">
                {{ include('customer/_form.html.twig', {
                    button_label: 'Save changes',
                    cancel_href: path('app_customer_show', {id: customer.id}),
                }) }}
            </div>
            {% if customer.createAt %}
                <div class="ce-created-foot" role="status">
                    <span class="ce-created-foot__k">Created</span>
                    <time class="ce-created-foot__v" datetime="{{ customer.createAt|date('c') }}">{{ customer.createAt|date('M j, Y g:i A') }}</time>
                </div>
            {% endif %}
        </div>

        {% if is_granted('ROLE_ADMIN') or (app.user and customer.createdBy and customer.createdBy.id == app.user.id) %}
            <section class="ce-delete-panel" aria-labelledby="ce-delete-title">
                <h2 id="ce-delete-title" class="ce-delete-panel__title">Delete customer</h2>
                <p class="ce-delete-panel__hint">This removes the customer record permanently. Orders may still exist depending on your data rules.</p>
                {{ include('customer/_delete_form.html.twig') }}
            </section>
        {% endif %}
    </div>
</main>
{% endblock %}

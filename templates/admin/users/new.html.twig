{% extends 'base.html.twig' %}

{% block title %}Create New User{% endblock %}

{% block body %}
<main class="h-full overflow-y-auto">
    <div class="container px-6 mx-auto grid">
        <h2 class="my-6 text-2xl font-semibold text-gray-700 dark:text-gray-200">Create New User</h2>

        <div class="px-4 py-3 mb-8 bg-white rounded-lg shadow-md dark:bg-gray-800">
            {{ form_start(form) }}
            <div class="grid gap-6 mb-8 md:grid-cols-2">
                <div>
                    {{ form_label(form.username, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_widget(form.username, {'attr': {'class': 'form-input w-full'}}) }}
                    {{ form_errors(form.username) }}
                </div>
                <div>
                    {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-input w-full'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div>
                    {{ form_label(form.roles, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_widget(form.roles, {'attr': {'class': 'form-select w-full'}}) }}
                    {{ form_errors(form.roles) }}
                </div>
                <div>
                    {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_widget(form.plainPassword, {'attr': {'class': 'form-input w-full'}}) }}
                    {{ form_errors(form.plainPassword) }}
                </div>
                <div>
                    {{ form_label(form.isActive, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_widget(form.isActive, {'attr': {'class': 'form-checkbox'}}) }}
                    {{ form_errors(form.isActive) }}
                </div>
            </div>
            <div class="flex justify-end space-x-4">
                <a href="{{ path('admin_user_index') }}" class="px-4 py-2 text-sm font-medium leading-5 text-gray-700 transition-colors duration-150 bg-gray-100 border border-transparent rounded-lg hover:bg-gray-200">
                    Cancel
                </a>
                <button type="submit" class="px-4 py-2 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-purple-600 border border-transparent rounded-lg active:bg-purple-600 hover:bg-purple-700 focus:outline-none focus:shadow-outline-purple">
                    Create User
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</main>
{% endblock %}


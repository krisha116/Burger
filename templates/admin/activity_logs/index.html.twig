{% extends 'base.html.twig' %}

{% block title %}Activity Logs{% endblock %}

{% block body %}
<main class="h-full overflow-y-auto">
    <div class="container px-6 mx-auto grid">
        <h2 class="my-6 text-2xl font-semibold text-gray-700 dark:text-gray-200">Activity Logs</h2>

        <!-- Filters -->
        <div class="mb-6 bg-white rounded-lg shadow-xs dark:bg-gray-800 p-4">
            <form method="get" class="flex flex-wrap gap-4">
                <select name="user" class="form-select">
                    <option value="">All Users</option>
                    {% for user in users %}
                        <option value="{{ user.id }}" {{ filters.user == user.id ? 'selected' : '' }}>{{ user.username }}</option>
                    {% endfor %}
                </select>
                <select name="action" class="form-select">
                    <option value="">All Actions</option>
                    {% for action in actions %}
                        <option value="{{ action }}" {{ filters.action == action ? 'selected' : '' }}>{{ action }}</option>
                    {% endfor %}
                </select>
                <input type="date" name="start_date" value="{{ filters.start_date }}" class="form-input" placeholder="Start Date">
                <input type="date" name="end_date" value="{{ filters.end_date }}" class="form-input" placeholder="End Date">
                <button type="submit" class="px-4 py-2 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-purple-600 border border-transparent rounded-lg hover:bg-purple-700">
                    Filter
                </button>
                <a href="{{ path('admin_activity_log_index') }}" class="px-4 py-2 text-sm font-medium leading-5 text-gray-700 transition-colors duration-150 bg-gray-100 border border-transparent rounded-lg hover:bg-gray-200">
                    Clear
                </a>
            </form>
        </div>

        <!-- Logs Table -->
        <div class="w-full overflow-hidden rounded-lg shadow-xs">
            <div class="w-full overflow-x-auto">
                <table class="w-full whitespace-no-wrap">
                    <thead>
                        <tr class="text-xs font-semibold tracking-wide text-left text-gray-500 uppercase border-b dark:border-gray-700 bg-gray-50 dark:text-gray-400 dark:bg-gray-800">
                            <th class="px-4 py-3">Timestamp</th>
                            <th class="px-4 py-3">User</th>
                            <th class="px-4 py-3">Role</th>
                            <th class="px-4 py-3">Action</th>
                            <th class="px-4 py-3">Entity</th>
                            <th class="px-4 py-3">Description</th>
                            <th class="px-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y dark:divide-gray-700 dark:bg-gray-800">
                        {% for log in logs %}
                        <tr class="text-gray-700 dark:text-gray-400">
                            <td class="px-4 py-3 text-sm">{{ log.createdAt ? log.createdAt|date('Y-m-d H:i:s') : '-' }}</td>
                            <td class="px-4 py-3 text-sm">{{ log.username ?? log.user.username }}</td>
                            <td class="px-4 py-3 text-sm">
                                {% set roleVal = log.role ?? (log.user.roles|first) %}
                                {% if roleVal == 'ROLE_ADMIN' or ('ROLE_ADMIN' in log.user.roles|default([])) %}
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800">Admin</span>
                                {% elseif roleVal == 'ROLE_STAFF' or ('ROLE_STAFF' in log.user.roles|default([])) %}
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Staff</span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">User</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-sm">
                                {% if log.action == 'CREATE' %}
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">CREATE</span>
                                {% elseif log.action == 'UPDATE' %}
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">UPDATE</span>
                                {% elseif log.action == 'DELETE' %}
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">DELETE</span>
                                {% elseif log.action == 'LOGIN' %}
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-teal-100 text-teal-800">LOGIN</span>
                                {% elseif log.action == 'LOGOUT' %}
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">LOGOUT</span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">{{ log.action }}</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-sm">
                                {% if log.entityType %}
                                    {{ log.entityType }}{% if log.entityId %} #{{ log.entityId }}{% endif %}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-sm">{{ log.description|default('-') }}</td>
                            <td class="px-4 py-3 text-sm">
                                <a href="{{ path('admin_activity_log_show', {id: log.id}) }}" class="text-purple-600 hover:text-purple-900">View</a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="px-4 py-3 text-center text-gray-500">No activity logs found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        {% if totalPages > 1 %}
        <div class="mt-6 flex justify-center">
            <nav class="flex space-x-2">
                {% if page > 1 %}
                    <a href="{{ path('admin_activity_log_index', {page: page - 1}|merge(filters)) }}" class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                        Previous
                    </a>
                {% endif %}
                {% for i in 1..totalPages %}
                    {% if i == page %}
                        <span class="px-3 py-2 text-sm font-medium text-white bg-purple-600 rounded-lg">{{ i }}</span>
                    {% else %}
                        <a href="{{ path('admin_activity_log_index', {page: i}|merge(filters)) }}" class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                            {{ i }}
                        </a>
                    {% endif %}
                {% endfor %}
                {% if page < totalPages %}
                    <a href="{{ path('admin_activity_log_index', {page: page + 1}|merge(filters)) }}" class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                        Next
                    </a>
                {% endif %}
            </nav>
        </div>
        {% endif %}

        <div class="mt-4 text-sm text-gray-600 dark:text-gray-400">
            Showing {{ logs|length }} of {{ totalLogs }} logs
        </div>
    </div>
</main>
{% endblock %}


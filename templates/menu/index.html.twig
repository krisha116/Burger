                    <div class="menu-price">120</div>
                </div>
            </div>

            <div class="menu-card" data-category="burger" data-tags="spicy">
                <div class="menu-card-image">
                    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=400&q=80" alt="Spicy Burger">
                    <div class="menu-category-badge">Burger</div>
                    <div class="menu-tag-badge">Spicy</div>
                </div>
                <div class="menu-info">
                    <h3>Spicy Jalapeño Burger</h3>

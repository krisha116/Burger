                    <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=400&q=80" alt="Classic Beef Burger">
                    <div class="menu-category-badge">Burger</div>
                    <div class="menu-tag-badge">Classic</div>

        </h1>
        <p class="page-subtitle" style="position:relative;z-index:2;">
            Discover our mouth-watering selection of burgers, hotdogs, fries, and refreshing drinks. All made with fresh, quality ingredients!
        </p>

        <!-- Filter Section -->
        <div class="filter-section">
            <div class="filter-grid">
                <div class="filter-group">
                    <label for="category">Category</label>
                    <select id="category" class="filter-input" onchange="filterMenu()">
                        <option value="all">All Categories</option>
                        <option value="burger">🍔 Burgers</option>
                        <option value="hotdog">🌭 Hotdogs</option>
                        <option value="fries">🍟 Fries</option>
                        <option value="drink">🥤 Drinks</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="search">Search Items</label>
                    <input type="text" id="search" class="filter-input search-input" onkeyup="filterMenu()" placeholder="Search for your favorite...">
                </div>
                <div class="filter-group">
                    <label for="tag">Special Tags</label>
                    <select id="tag" class="filter-input" onchange="filterMenu()">

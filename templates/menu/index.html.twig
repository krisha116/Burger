<script>
    // Enhanced filtering with smooth animations and better UX
    function filterMenu() {
        const category = document.getElementById('category').value;
        const search = document.getElementById('search').value.toLowerCase();
        const tag = document.getElementById('tag').value;
        const cards = document.querySelectorAll('.menu-card');
        const noResults = document.getElementById('noResults');
        const loading = document.getElementById('loading');
        
        // Show loading animation
        loading.style.display = 'block';
        noResults.style.display = 'none';
        
        // Hide all cards first
        cards.forEach(card => {
            card.style.display = 'none';
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
        });
        
        // Filter cards with delay for smooth animation
        setTimeout(() => {
            let visibleCount = 0;
            
            cards.forEach(card => {
                const cardCategory = card.getAttribute('data-category');
                const cardTags = card.getAttribute('data-tags');
                const name = card.querySelector('h3').textContent.toLowerCase();
                
                let show = true;
                
                if (category !== 'all' && cardCategory !== category) show = false;
                if (tag !== 'all' && cardTags !== tag) show = false;
                if (search && !name.includes(search)) show = false;
                
                if (show) {
                    card.style.display = 'block';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                    visibleCount++;
                }
            });
            
            // Show no results message if no items match
            if (visibleCount === 0) {
                noResults.style.display = 'block';
            }
            
            loading.style.display = 'none';
        }, 300);
    }
    
    // Reset all filters
    function resetFilters() {
        document.getElementById('category').value = 'all';
        document.getElementById('search').value = '';
        document.getElementById('tag').value = 'all';
        filterMenu();
    }
    
    // Add smooth scroll behavior for better UX
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize the menu display
        filterMenu();
        
        // Add smooth scrolling to anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
        
        // Add keyboard navigation support
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                resetFilters();
            }
        });
    });
    
    // Add search suggestions (optional enhancement)
    function addSearchSuggestions() {
        const searchInput = document.getElementById('search');
        const suggestions = [
            'burger', 'hotdog', 'fries', 'drink',
            'spicy', 'veggie', 'deluxe', 'classic',
            'beef', 'chicken', 'cheese', 'bacon'
        ];
        
        searchInput.addEventListener('input', function() {
            const value = this.value.toLowerCase();
            if (value.length > 1) {
                // You could implement autocomplete here
                console.log('Searching for:', value);
            }
        });
    }
    
    // Initialize search suggestions
    addSearchSuggestions();
</script>

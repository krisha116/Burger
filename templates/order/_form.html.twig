{{ form_start(form) }}
    <div class="form-group">
        {{ form_label(form.Name, 'Name') }}
        {{ form_widget(form.Name, { 'attr': {'placeholder': 'Enter order name'} }) }}
        {{ form_errors(form.Name) }}
    </div>

    <div class="form-group">
        {{ form_label(form.createAt, 'Date & Time') }}
        {{ form_widget(form.createAt, { 'attr': {'placeholder': 'Select date and time'} }) }}
        {{ form_errors(form.createAt) }}
    </div>

    <div class="form-group">
        {{ form_label(form.Total, 'Total') }}
        {{ form_widget(form.Total, { 'attr': {'placeholder': '0.00', 'step': '0.01'} }) }}
        {{ form_errors(form.Total) }}
    </div>

    <div class="form-group">
        {{ form_label(form.Status, 'Status') }}
        {{ form_widget(form.Status) }}
        {{ form_errors(form.Status) }}
    </div>

    <div class="form-group" style="display:flex; gap:1rem; align-items:flex-start;">
        <div style="flex:1;">
            {{ form_label(form.Customer, 'Customer') }}
            {{ form_widget(form.Customer) }}
            {{ form_errors(form.Customer) }}
        </div>
        <div style="flex:1;">
            {{ form_label(form.products, 'Products') }}
            {{ form_widget(form.products) }}
            {{ form_errors(form.products) }}
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">{{ button_label|default('Save Order') }}</button>
        {% if extraActions is defined %}
            {{ extraActions|raw }}
        {% endif %}
    </div>
{{ form_end(form) }}

{% extends 'base.html.twig' %}

{% block title %}Orders{% endblock %}

{% block body %}
{% block header_search %}{% endblock %}

<main class="ord-page">
  <div class="ord-page__inner">
    <header class="ord-toolbar ord-toolbar--actions-only">
      <h1 class="pp-sr-only">Orders</h1>
      <a href="{{ path('app_order_new') }}" class="pp-create-btn">
        <span aria-hidden="true">+</span> Add order
      </a>
    </header>

    <div class="ord-filters">
      <form method="get" class="ord-filters__form" aria-label="Search and filter orders">
        <input type="hidden" name="sort" value="date">
        <div class="pp-field ord-search-field">
          <label for="ord-search">Search</label>
          <input type="search" id="ord-search" name="search" value="{{ search }}" class="ord-search" placeholder="Order name or customer…" autocomplete="off">
        </div>
        <div class="pp-field ord-select-wrap">
          <label for="ord-filter-status">Status</label>
          <select id="ord-filter-status" name="status" class="pp-select">
            <option value="" {{ statusFilter is empty ? 'selected' : '' }}>All statuses</option>
            <option value="Pending" {{ statusFilter == 'Pending' ? 'selected' : '' }}>Pending</option>
            <option value="Completed" {{ statusFilter == 'Completed' ? 'selected' : '' }}>Completed</option>
          </select>
        </div>
        <div class="pp-field ord-select-wrap">
          <label for="ord-filter-date">Date order</label>
          <select id="ord-filter-date" name="dir" class="pp-select" aria-describedby="ord-date-hint">
            <option value="desc" {{ dir == 'desc' ? 'selected' : '' }}>Newest first</option>
            <option value="asc" {{ dir == 'asc' ? 'selected' : '' }}>Oldest first</option>
          </select>
          <span id="ord-date-hint" class="pp-sr-only">Applies to order date column</span>
        </div>
        <div class="ord-filter-actions">
          <button type="submit" class="pp-btn-filter">Apply</button>
          <a href="{{ path('app_order_index') }}" class="pp-btn-clear">Reset</a>
        </div>
      </form>
    </div>

    <section class="ord-table-panel" aria-labelledby="ord-table-heading">
      <div class="ord-table-panel__head">
        <h2 id="ord-table-heading">All orders</h2>
      </div>
      <div class="ord-datatable-scroll">
        <table id="ordersIndexTable" class="ord-table">
          <thead>
            <tr>
              <th scope="col">ID</th>
              <th scope="col">Name</th>
              <th scope="col">Customer</th>
              <th scope="col">Category</th>
              <th scope="col">Date</th>
              <th scope="col">Status</th>
              <th scope="col">Total</th>
              <th scope="col">Payment</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for order in orders %}
              {% set productNameParts = [] %}
              {% for p in order.products %}
                {% set productNameParts = productNameParts|merge([p.Name]) %}
              {% endfor %}
              {% set productNamesJoined = productNameParts|join(', ') %}
              {% set categoryLabels = order_category_labels(order) %}
              {% set displayOrderName = productNamesJoined != '' ? productNamesJoined : order.Name %}
              <tr>
                <td class="ord-id">#{{ order.id }}</td>
                <td class="ord-name ord-cell-clip" title="{{ displayOrderName|e('html_attr') }}">{{ displayOrderName }}</td>
                <td class="ord-cell-clip" title="{{ order.Customer ? order.Customer.Name|e('html_attr') : '' }}">{{ order.Customer ? order.Customer.Name : '—' }}</td>
                <td class="ord-cell-clip" title="{{ productNamesJoined|e('html_attr') }}">{{ categoryLabels }}</td>
                <td class="ord-date">{{ order.createAt ? order.createAt|date('M j, Y') : '—' }}</td>
                <td>
                  {% set st = order.Status|lower %}
                  {% if st in ['completed', 'approved', 'paid', 'delivered'] %}
                    <span class="order-status order-status--success">{{ order.Status }}</span>
                  {% elseif st == 'pending' %}
                    <span class="order-status order-status--warning">{{ order.Status }}</span>
                  {% elseif st in ['cancelled', 'canceled', 'expired'] %}
                    <span class="order-status order-status--muted">{{ order.Status }}</span>
                  {% else %}
                    <span class="order-status order-status--danger">{{ order.Status }}</span>
                  {% endif %}
                </td>
                <td class="ord-total">₱{{ order.Total|number_format(2, '.', ',') }}</td>
                <td class="ord-payment">
                  {% if order.paymentMethod == 'cash' %}Cash
                  {% elseif order.paymentMethod == 'gcash' %}GCash
                  {% elseif order.paymentMethod == 'atm' %}ATM
                  {% else %}—{% endif %}
                </td>
                <td>
                  <div class="ord-actions">
                    <a href="{{ path('app_order_show', {id: order.id}) }}" class="ord-action-btn ord-action-btn--view">View</a>
                    {% if order.Status|lower != 'completed' and (is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') or (app.user and order.createdBy and order.createdBy.id == app.user.id)) %}
                      <a href="{{ path('app_order_edit', {id: order.id}) }}" class="ord-action-btn ord-action-btn--edit">Edit</a>
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% else %}
              <tr class="ord-empty-row">
                <td colspan="9">No orders match your filters.</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.DataTable) {
      new DataTable('#ordersIndexTable', {
        responsive: true,
        searching: false,
        paging: false,
        lengthChange: false,
        info: false,
        order: [],
        language: {
          emptyTable: 'No orders match your filters.',
        },
      });
    }
  });
</script>
{% endblock %}

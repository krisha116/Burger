{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}
<main class="h-full overflow-y-auto">
    <div class="container px-6 mx-auto grid">
        <h2 class="my-6 text-2xl font-semibold text-gray-700 dark:text-gray-200">Change Password</h2>

        {% for flash_error in app.flashes('error') %}
            <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
                {{ flash_error }}
            </div>
        {% endfor %}

        <div class="px-4 py-3 mb-8 bg-white rounded-lg shadow-md dark:bg-gray-800">
            {{ form_start(form) }}
            <div class="grid gap-6 mb-8 md:grid-cols-1">
                <div>
                    {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_widget(form.currentPassword, {'attr': {'class': 'form-input w-full'}}) }}
                    {{ form_errors(form.currentPassword) }}
                </div>
                <div>
                    {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-input w-full'}}) }}
                    {{ form_errors(form.newPassword.first) }}
                </div>
                <div>
                    {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-input w-full'}}) }}
                    {{ form_errors(form.newPassword.second) }}
                </div>
            </div>
            <div class="flex justify-end space-x-4">
                <a href="{{ path('profile_show') }}" class="px-4 py-2 text-sm font-medium leading-5 text-gray-700 transition-colors duration-150 bg-gray-100 border border-transparent rounded-lg hover:bg-gray-200">
                    Cancel
                </a>
                <button type="submit" class="px-4 py-2 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-purple-600 border border-transparent rounded-lg active:bg-purple-600 hover:bg-purple-700 focus:outline-none focus:shadow-outline-purple">
                    Change Password
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</main>
{% endblock %}


{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
        <main style="flex: 1; overflow: hidden; display: flex; flex-direction: column;">
          <div class="container px-4 mx-auto py-3" style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
            <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-200 mb-3">
              Dashboard
            </h2>
            
            <!-- Admin Statistics Cards -->
            {% if is_granted('ROLE_ADMIN') %}
            <div class="grid gap-3 mb-3 md:grid-cols-2 xl:grid-cols-4" style="flex-shrink: 0;">
              <a href="{{ path('admin_user_index') }}" class="card-stat">
                <div class="card-stat-icon" style="background: linear-gradient(135deg, #7C3AED 0%, #5B21B6 100%);">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                  </svg>
                </div>
                <div class="card-stat-content">
                  <h3>Total Users</h3>
                  <p>{{ totalUsers }}</p>
                </div>
              </a>
              <a href="{{ path('admin_user_index') }}?role=ROLE_STAFF" class="card-stat">
                <div class="card-stat-icon" style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                </div>
                <div class="card-stat-content">
                  <h3>Total Staff</h3>
                  <p>{{ totalStaff }}</p>
                </div>
              </a>
              <div class="card-stat">
                <div class="card-stat-icon" style="background: linear-gradient(135deg, #14B8A6 0%, #0D9488 100%);">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                </div>
                <div class="card-stat-content">
                  <h3>Total Records</h3>
                  <p>{{ totalRecords }}</p>
                </div>
              </div>
              <a href="{{ path('admin_activity_log_index') }}" class="card-stat">
                <div class="card-stat-icon" style="background: linear-gradient(135deg, #FF6B35 0%, #E85A2B 100%);">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div class="card-stat-content">
                  <h3>Recent Activities</h3>
                  <p>{{ recentActivities|length }}</p>
                </div>
              </a>
            </div>
            {% endif %}
            
            <!-- Cards -->
            <div class="grid gap-3 mb-3 md:grid-cols-2 xl:grid-cols-4" style="flex-shrink: 0;">
              <a href="{{ path('app_customer_index') }}" class="card-stat">
                <div class="card-stat-icon" style="background: linear-gradient(135deg, #FF6B35 0%, #E85A2B 100%);">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path>
                  </svg>
                </div>
                <div class="card-stat-content">
                  <h3>Customers</h3>
                  <p>{{ customerCount }}</p>
                </div>
              </a>
              <a href="{{ path('app_order_index') }}" class="card-stat">
                <div class="card-stat-icon" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div class="card-stat-content">
                  <h3>Total Sales</h3>
                  <p>${{ totalSales|number_format(2, '.', ',') }}</p>
                </div>
              </a>
              <a href="{{ path('app_order_index') }}" class="card-stat">
                <div class="card-stat-icon" style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"></path>
                  </svg>
                </div>
                <div class="card-stat-content">
                  <h3>Orders</h3>
                  <p>{{ orderCount }}</p>
                </div>
              </a>
              <a href="{{ path('app_product_index') }}" class="card-stat">
                <div class="card-stat-icon" style="background: linear-gradient(135deg, #14B8A6 0%, #0D9488 100%);">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 5v8a2 2 0 01-2 2h-5l-5 4v-4H4a2 2 0 01-2-2V5a2 2 0 012-2h12a2 2 0 012 2zM7 8H5v2h2V8zm2 0h2v2H9V8zm6 0h-2v2h2V8z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div class="card-stat-content">
                  <h3>Products</h3>
                  <p>{{ productCount }}</p>
                </div>
              </a>
            </div>
            <!-- New Table -->
            <div class="table-modern" style="flex: 1; display: flex; flex-direction: column; overflow: hidden; min-height: 0;">
              <div class="w-full overflow-auto" style="flex: 1;">
                <table id="ordersTable" class="w-full whitespace-no-wrap" style="font-size: 0.875rem;">
                  <thead>
                    <tr class="text-xs font-semibold tracking-wide text-left text-gray-500 uppercase border-b dark:border-gray-700 bg-gray-50 dark:text-gray-400 dark:bg-gray-800">
                      <th class="px-3 py-2">Order</th>
                      <th class="px-3 py-2">Customer</th>
                      <th class="px-3 py-2">Products</th>
                      <th class="px-3 py-2">Amount</th>
                      <th class="px-3 py-2">Status</th>
                      <th class="px-3 py-2">Date</th>
                    </tr>
                  </thead>
                  <tbody class="bg-white divide-y dark:divide-gray-700 dark:bg-gray-800">
                    {% for order in recentOrders %}
                    <tr class="text-gray-700 dark:text-gray-400">
                      <td class="px-3 py-2">
                        <div class="flex items-center text-sm">
                          <div>
                            <a href="{{ path('app_order_show', {id: order.id}) }}" class="font-semibold hover:underline text-xs">{{ order.Name }}</a>
                            <p class="text-xs text-gray-600 dark:text-gray-400">#{{ order.id }}</p>
                          </div>
                        </div>
                      </td>
                      <td class="px-3 py-2 text-xs">
                        {{ order.Customer ? order.Customer.Name : '-' }}
                      </td>
                      <td class="px-3 py-2 text-xs">
                        {% if order.products|length > 0 %}
                          {% for p in order.products|slice(0, 2) %}{% if not loop.first %}, {% endif %}{{ p.Name }}{% endfor %}{% if order.products|length > 2 %}...{% endif %}
                        {% else %}-{% endif %}
                      </td>
                      <td class="px-3 py-2 text-xs">
                        ${{ order.Total|number_format(2, '.', ',') }}
                      </td>
                      <td class="px-3 py-2 text-xs">
                        {% set status = order.Status|lower %}
                        {% set classes = status == 'approved' ? 'text-green-700 bg-green-100 dark:bg-green-700 dark:text-green-100' : (status == 'pending' ? 'text-orange-700 bg-orange-100 dark:text-white dark:bg-orange-600' : (status == 'expired' ? 'text-gray-700 bg-gray-100 dark:text-gray-100 dark:bg-gray-700' : 'text-red-700 bg-red-100 dark:text-red-100 dark:bg-red-700')) %}
                        <span class="px-1.5 py-0.5 text-xs font-semibold leading-tight rounded-full {{ classes }}">
                          {{ order.Status }}
                        </span>
                      </td>
                      <td class="px-3 py-2 text-xs">
                        {{ order.createAt ? order.createAt|date('n/j/Y') : '-' }}
                      </td>
                    </tr>
                    {% else %}
                    <tr>
                      <td colspan="6" class="px-4 py-4 text-center text-gray-500 text-sm">No recent orders</td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              <script>
                document.addEventListener('DOMContentLoaded', function () {
                  if (window.DataTable) {
                    new DataTable('#ordersTable', {
                      responsive: true,
                      searching: true,
                      paging: true,
                      info: true,
                      lengthChange: true,
                      order: [],
                    });
                  }
                });
              </script>
              <div class="grid px-3 py-2 text-xs font-semibold tracking-wide text-gray-500 uppercase border-t dark:border-gray-700 bg-gray-50 sm:grid-cols-9 dark:text-gray-400 dark:bg-gray-800" style="flex-shrink: 0;">
                {% set start = totalOrders > 0 ? ((page - 1) * perPage + 1) : 0 %}
                {% set end = (page * perPage) > totalOrders ? totalOrders : (page * perPage) %}
                <span class="flex items-center col-span-3">
                  Showing {{ start }}-{{ end }} of {{ totalOrders }}
                </span>
                <span class="col-span-2"></span>
                <!-- Pagination -->
                <span class="flex col-span-4 mt-2 sm:mt-auto sm:justify-end">
                  <nav aria-label="Table navigation">
                    <ul class="inline-flex items-center">
                      <li>
                        {% if page > 1 %}
                          <a href="{{ path('app_dashboard', {page: page - 1, q: app.request.get('q'), sort: app.request.get('sort'), dir: app.request.get('dir')}) }}" class="px-3 py-1 rounded-md rounded-l-lg focus:outline-none focus:shadow-outline-purple" aria-label="Previous">
                            <svg aria-hidden="true" class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" fill-rule="evenodd"></path></svg>
                          </a>
                        {% else %}
                          <span class="px-3 py-1 opacity-50 cursor-not-allowed rounded-md rounded-l-lg" aria-label="Previous">
                            <svg aria-hidden="true" class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" fill-rule="evenodd"></path></svg>
                          </span>
                        {% endif %}
                      </li>
                      {% for p in range(1, totalPages) %}
                        <li>
                          {% if p == page %}
                            <span class="px-3 py-1 text-white transition-colors duration-150 bg-purple-600 border border-purple-600 rounded-md focus:outline-none focus:shadow-outline-purple">{{ p }}</span>
                          {% else %}
                            <a href="{{ path('app_dashboard', {page: p, q: app.request.get('q'), sort: app.request.get('sort'), dir: app.request.get('dir')}) }}" class="px-3 py-1 rounded-md focus:outline-none focus:shadow-outline-purple">{{ p }}</a>
                          {% endif %}
                        </li>
                      {% endfor %}
                      <li>
                        {% if page < totalPages %}
                          <a href="{{ path('app_dashboard', {page: page + 1, q: app.request.get('q'), sort: app.request.get('sort'), dir: app.request.get('dir')}) }}" class="px-3 py-1 rounded-md rounded-r-lg focus:outline-none focus:shadow-outline-purple" aria-label="Next">
                            <svg class="w-4 h-4 fill-current" aria-hidden="true" viewBox="0 0 20 20"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" fill-rule="evenodd"></path></svg>
                          </a>
                        {% else %}
                          <span class="px-3 py-1 opacity-50 cursor-not-allowed rounded-md rounded-r-lg" aria-label="Next">
                            <svg class="w-4 h-4 fill-current" aria-hidden="true" viewBox="0 0 20 20"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" fill-rule="evenodd"></path></svg>
                          </span>
                        {% endif %}
                      </li>
                    </ul>
                  </nav>
                </span>
              </div>
            </div>

            <!-- Charts - Hidden to save space, can be shown if needed -->
            <!--
            <h2 class="my-3 text-xl font-semibold text-gray-700 dark:text-gray-200">
              Charts
            </h2>
            <div class="grid gap-3 mb-3 md:grid-cols-2" style="flex-shrink: 0;">
              <div
                class="min-w-0 p-4 bg-white rounded-lg shadow-xs dark:bg-gray-800"
              >
                <h4 class="mb-4 font-semibold text-gray-800 dark:text-gray-300">
                  Revenue
                </h4>
                <canvas id="pie"></canvas>
                <div
                  class="flex justify-center mt-4 space-x-3 text-sm text-gray-600 dark:text-gray-400"
                >
                <!-- Chart legend --> 
                  <!-- Chart legend -->
                      {% if is_granted('ROLE_ADMIN') %}
                          <p>Welcome, Admin! You have full access to the dashboard.</p>
   
                      {% elseif is_granted('ROLE_STAFF') %}
                          <p>Welcome, Staff! You have moderate access to the dashboard.</p>
   
                      {% elseif is_granted('ROLE_USER') %}
                          <p>Welcome, User! You have limited access to the dashboard.</p>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            -->
          </div>

          

{% endblock %}

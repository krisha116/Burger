{% block title %}{% endblock %}

{% block body %}
<style>
    body {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #f2f2f2;
        font-family: Arial, sans-serif;
    }

    .register-container {
        background: #ffffff;
        padding: 35px 40px;
        border-radius: 10px;
        width: 350px;
        box-shadow: 0 0 10px rgba(0,0,0,0.08);
    }

    .register-container h1 {
        text-align: center;
        font-weight: 600;
        margin-bottom: 20px;
        font-size: 24px;
    }

    form div {
        margin-bottom: 15px;
    }

    .btn-submit {
        width: 100%;
        padding: 10px;
        border: none;
        background: #111;
        color: #fff;
        font-size: 15px;
        border-radius: 5px;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-submit:hover {
        opacity: .85;
    }
</style>

<div class="register-container">
    <h1>Register</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.username) }}
        {{ form_row(registrationForm.plainPassword, { label: 'Password' }) }}
        {{ form_row(registrationForm.agreeTerms) }}

        <button type="submit" class="btn-submit">Register</button>
    {{ form_end(registrationForm) }}
</div>
{% endblock %}

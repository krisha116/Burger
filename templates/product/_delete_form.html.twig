<form method="post" action="{{ path('app_product_delete', {'id': product.id}) }}" class="cd-inline-form" onsubmit="return confirm('Delete this product permanently?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
    <button type="submit" class="ue-btn ue-btn--danger">Delete</button>
</form>

      </aside>
      <div class="flex flex-col w-full main-content" style="min-height: 100vh;">
        <header class="header-modern" style="flex-shrink: 0;">
          <div class="container flex items-center justify-between">
            <!-- Mobile hamburger -->
            <button
              class="p-2 rounded-lg md:hidden hover:bg-gray-100 transition-colors"
              @click="toggleSideMenu"
              aria-label="Menu"
            >
              <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
            {% block header_search %}
            <!-- Search input -->
            {% endblock %}
            <div class="user-menu">
              {% if app.user %}
              <div class="user-info">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center text-white font-semibold text-sm">
                  {{ app.user.userIdentifier|first|upper }}
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-800">{{ app.user.userIdentifier }}</div>
                  <div class="text-xs text-gray-500">
                    {% if is_granted('ROLE_ADMIN') %}Administrator{% elseif is_granted('ROLE_STAFF') %}Staff workspace{% else %}Customer{% endif %}
                  </div>
                </div>
              </div>
              {% endif %}
            </div>
          </div>
        </header>
        
        <!-- Flash Messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="container px-6 mx-auto mt-4">
                    <div class="flash-message flash-{{ label }}">
                        <span>{{ message }}</span>
                        <button onclick="this.parentElement.remove()" class="text-lg font-bold opacity-50 hover:opacity-100 transition-opacity">&times;</button>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
        
   {% block body %}{% endblock %}
      </div>
    </div>
    
    {% if app.user %}
    {# Check if user account is disabled - the UserStatusSubscriber will handle server-side logout #}
    {% if app.user.isActive is same as(false) %}
        <script>
            // User account is disabled - redirect to logout
            // This is a backup check, UserStatusSubscriber handles it server-side
            window.location.href = '{{ path('app_logout') }}';
        </script>
    {% endif %}
    
    <script>
        // Prevent back button access to cached pages after logout
        (function() {
            // Check if page was loaded from cache (back/forward button)
            window.addEventListener('pageshow', function(event) {
                if (event.persisted) {
                    // Page was loaded from cache - force reload to verify authentication
                    // This ensures the server checks if user is still authenticated
                    window.location.reload();
                }
            });
        })();
    </script>
    {% endif %}
  </body>
</html>

